# Port the HTTP server listens on (Railway and most platforms set this for you).
PORT=4000

# Comma-separated site domains the ingest endpoint accepts events for.
TALLY_SITES="harrowfield.co"

# Stats API keys as comma-separated key:plan pairs (plans: starter, growth, business).
# Generate keys with: openssl rand -hex 24
TALLY_API_KEYS=""

# How long stored events are kept in memory, in days.
TALLY_RETENTION_DAYS=400

# Optional in production; a random one is generated at boot when unset.
SECRET_KEY_BASE=""

# Host name the service is reachable at (used for generated URLs).
PHX_HOST="localhost"

# Set by the Docker image; needed when starting a release by hand.
PHX_SERVER=true
